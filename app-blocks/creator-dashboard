            icon={Radio}
            label="Live Streams"
            value={f.liveStreams !== null ? String(f.liveStreams) : "—"}
            sub={f.avgLiveViews ? `Avg ${f.avgLiveViews} views` : undefined}
            color={CS.blue4}
          />
        </div>

        {/* ── Sales Channels + Performance KPIs ── */}
        <div className="grid gap-4 md:grid-cols-2">
          {/* Sales Channel Donut */}
          <Card className="border-0 shadow-sm" style={{ backgroundColor: CS.light1 }}>
            <CardHeader className="pb-2">
              <CardTitle className="text-base" style={{ color: CS.navy }}>Sales Channels</CardTitle>
              <CardDescription>GMV breakdown by channel</CardDescription>
            </CardHeader>
            <CardContent>
              {(videoChannelPct > 0 || productCardsPct > 0) ? (
                <DonutChart segments={[
                  { value: videoChannelPct, color: CS.blue, label: "Video" },
                  { value: productCardsPct, color: CS.blue4, label: "Product Cards" },
                ]} />
              ) : (
                <p className="text-sm text-muted-foreground">No channel data available</p>
              )}
            </CardContent>
          </Card>

          {/* Performance KPIs */}
          <Card className="border-0 shadow-sm" style={{ backgroundColor: CS.light1 }}>
            <CardHeader className="pb-2">
              <CardTitle className="text-base" style={{ color: CS.navy }}>Performance</CardTitle>
              <CardDescription>Key performance indicators</CardDescription>
            </CardHeader>
            <CardContent className="space-y-4">
              {f.gmvPerCustomer !== null && (
                <div className="flex justify-between items-center">
                  <span className="text-sm text-muted-foreground">GMV per Customer</span>
                  <span className="font-bold" style={{ color: CS.navy }}>{typeof f.gmvPerCustomer === 'number' ? `£${f.gmvPerCustomer.toFixed(2)}` : f.gmvPerCustomer}</span>
                </div>
              )}
              {f.avgCommissionRate && (
                <div className="flex justify-between items-center">
                  <span className="text-sm text-muted-foreground">Avg Commission Rate</span>
                  <span className="font-bold" style={{ color: CS.navy }}>{f.avgCommissionRate}</span>
                </div>
              )}
              {f.brandCollaborations !== null && (
                <div className="flex justify-between items-center">
                  <span className="text-sm text-muted-foreground">Brand Collaborations</span>
                  <span className="font-bold" style={{ color: CS.navy }}>{f.brandCollaborations}</span>
                </div>
              )}
              {f.productPrice && (
                <div className="flex justify-between items-center">
                  <span className="text-sm text-muted-foreground">Avg Product Price</span>
                  <span className="font-bold" style={{ color: CS.navy }}>{f.productPrice}</span>
                </div>
              )}
            </CardContent>
          </Card>
        </div>

        {/* ── Category GMV Chart ── */}
        {categories.length > 0 && (
          <Card className="border-0 shadow-sm" style={{ backgroundColor: CS.light1 }}>
            <CardHeader className="pb-2">
              <CardTitle className="text-base" style={{ color: CS.navy }}>Top Categories by GMV</CardTitle>
            </CardHeader>
            <CardContent className="space-y-3">
              {categories.map((cat, i) => (
                <HorizontalBar key={i} label={cat.name} value={cat.pct} maxValue={maxCat} color={cat.color} />
              ))}
            </CardContent>
          </Card>
        )}

        {/* ── Demographics: Gender Donut + Age Bars ── */}
        <div className="grid gap-4 md:grid-cols-2">
          {/* Gender */}
          <Card className="border-0 shadow-sm" style={{ backgroundColor: CS.light1 }}>
            <CardHeader className="pb-2">
              <CardTitle className="text-base" style={{ color: CS.navy }}>Audience Gender</CardTitle>
            </CardHeader>
            <CardContent>
              {(femaleVal > 0 || maleVal > 0) ? (
                <DonutChart segments={[
                  { value: femaleVal, color: CS.blue3, label: "Female" },
                  { value: maleVal, color: CS.navy2, label: "Male" },
                ]} />
              ) : (
                <p className="text-sm text-muted-foreground">No gender data available</p>
              )}
            </CardContent>
          </Card>

          {/* Age */}
          <Card className="border-0 shadow-sm" style={{ backgroundColor: CS.light1 }}>
            <CardHeader className="pb-2">
              <CardTitle className="text-base" style={{ color: CS.navy }}>Age Distribution</CardTitle>
            </CardHeader>
            <CardContent className="space-y-3">
              {ageData.some(a => a.value > 0) ? (
                ageData.map((age, i) => (
                  <HorizontalBar key={i} label={age.label} value={age.value} maxValue={maxAge} color={age.color} />
                ))
              ) : (
                <p className="text-sm text-muted-foreground">No age data available</p>
              )}
            </CardContent>
          </Card>
        </div>

        {/* ── Top Locations ── */}
        {locations.length > 0 && (
          <Card className="border-0 shadow-sm" style={{ backgroundColor: CS.light1 }}>
            <CardHeader className="pb-2">
              <div className="flex items-center gap-2">
                <MapPin className="h-4 w-4" style={{ color: CS.blue }} />
                <CardTitle className="text-base" style={{ color: CS.navy }}>Top Locations</CardTitle>
              </div>
            </CardHeader>
            <CardContent>
              <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-2">
                {locations.map((loc, i) => (
                  <LocationBadge key={i} rank={i + 1} name={String(loc)} />
                ))}
              </div>
            </CardContent>
          </Card>
        )}

        {/* ── Video vs Live Performance ── */}
        <div className="grid gap-4 md:grid-cols-2">
          <Card className="border-0 shadow-sm" style={{ backgroundColor: CS.light1 }}>
            <CardHeader className="pb-2">
              <div className="flex items-center gap-2">
                <Video className="h-4 w-4" style={{ color: CS.blue }} />
                <CardTitle className="text-base" style={{ color: CS.navy }}>Video Performance</CardTitle>
              </div>
            </CardHeader>
            <CardContent className="space-y-3">
              {f.videoGpm !== null && (
                <div className="flex justify-between items-center">
                  <span className="text-sm text-muted-foreground">Video GPM</span>
                  <span className="font-bold text-lg" style={{ color: CS.blue }}>{typeof f.videoGpm === 'number' ? `£${f.videoGpm.toFixed(2)}` : f.videoGpm}</span>
                </div>
              )}
              {f.avgVideoViews !== null && (
                <div className="flex justify-between items-center">
                  <span className="text-sm text-muted-foreground">Avg Views</span>
                  <span className="font-semibold" style={{ color: CS.navy }}>{Number(f.avgVideoViews).toLocaleString()}</span>
                </div>
              )}
              {f.avgVideoEngagement && (
                <div className="flex justify-between items-center">
                  <span className="text-sm text-muted-foreground">Avg Engagement</span>
                  <span className="font-semibold" style={{ color: CS.navy }}>{f.avgVideoEngagement}</span>
                </div>
              )}
            </CardContent>
          </Card>

          <Card className="border-0 shadow-sm" style={{ backgroundColor: CS.light1 }}>
            <CardHeader className="pb-2">
              <div className="flex items-center gap-2">
                <Radio className="h-4 w-4" style={{ color: CS.red }} />
                <CardTitle className="text-base" style={{ color: CS.navy }}>Live Performance</CardTitle>
              </div>
            </CardHeader>
            <CardContent className="space-y-3">
              {f.liveGpm !== null && (
                <div className="flex justify-between items-center">
                  <span className="text-sm text-muted-foreground">Live GPM</span>
                  <span className="font-bold text-lg" style={{ color: CS.red }}>{typeof f.liveGpm === 'number' ? `£${f.liveGpm.toFixed(2)}` : f.liveGpm}</span>
                </div>
              )}
              {f.avgLiveViews && (
                <div className="flex justify-between items-center">
                  <span className="text-sm text-muted-foreground">Avg Views</span>
                  <span className="font-semibold" style={{ color: CS.navy }}>{f.avgLiveViews}</span>
                </div>
              )}
              {f.avgLiveEngagement && (
                <div className="flex justify-between items-center">
                  <span className="text-sm text-muted-foreground">Avg Engagement</span>
                  <span className="font-semibold" style={{ color: CS.navy }}>{f.avgLiveEngagement}</span>
                </div>
              )}
            </CardContent>
          </Card>
        </div>

        {/* ── Top Videos ── */}
        {videos.length > 0 && (
          <Card className="border-0 shadow-sm" style={{ backgroundColor: CS.light1 }}>
            <CardHeader className="pb-2">
              <CardTitle className="text-base" style={{ color: CS.navy }}>Top Videos with Products</CardTitle>
            </CardHeader>
            <CardContent>
              <div className="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {videos.map((vid, i) => (
                  <VideoCard
                    key={i}
                    embed={vid.embed}
                    fallbackUrl={vid.url}
                    title={vid.title}
                    stats={[
                      { icon: Eye, value: vid.views, color: CS.blue3 },
                      { icon: Heart, value: vid.likes, color: CS.red },
                    ]}
                  />
                ))}
              </div>
            </CardContent>
          </Card>
        )}
      </div>
    </div>
  );
}
